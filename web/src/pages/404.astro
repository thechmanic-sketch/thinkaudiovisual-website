---
import { u } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Think Audio Visual" description="This page could not be found." noindex>
  <section class="min-h-[80vh] grid place-items-center text-center pt-24">
    <div class="container-stage">
      <p class="spec !text-signal-ink">Error 404 · No signal</p>
      <h1 class="display-xl mt-4">Mic's off</h1>
      <p class="lead mx-auto mt-6">We couldn't find that page.</p>
      <a href={u('/')} class="btn btn-primary mt-8">Back to home</a>
    </div>
  </section>
</BaseLayout>
