---
import { u } from '../../utils/url';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import { services, whatsappHref } from '../../data/site';
import { img, heroSlides } from '../../data/images';

const sound = services[0];

const packages = [
  { name: 'Speech & Presentation', spec: 'Up to 100 guests', items: ['2 × powered PA speakers on stands', '2 × wireless microphones', 'Compact mixer', 'Laptop audio connection'] },
  { name: 'Wedding & Party', spec: '100–300 guests', items: ['PA tops + subwoofers', 'Wireless mics for speeches', 'DJ setup or playback', 'Optional uplighting'] },
  { name: 'Live & Outdoor', spec: '300+ guests', items: ['JBL line-array system', 'Subwoofer stacks', 'Digital desk + engineer', 'Band backline & monitors'] },
];

// TODO(owner): confirm every answer below before launch.
const faqs = [
  { q: 'Do you supply a sound engineer?', a: 'Yes. Our team sets up, sound-checks and operates the system for the duration of your event, then packs everything away.' },
  { q: 'What speakers do you use?', a: 'We run professional JBL speaker systems, from compact PA tops for speeches to line arrays and subwoofers for concerts and outdoor events.' },
  { q: 'How far in advance should I book?', a: 'As early as possible, especially for weekends and the December season. Send us your date and we will confirm availability within 24 hours.' },
  { q: 'Do you work outside Durban?', a: 'Yes. We cover Durban and greater KwaZulu-Natal, including Umhlanga, Ballito, Pinetown and Pietermaritzburg. Travel is quoted per event.' },
  { q: 'Can you help me choose the right system?', a: 'Absolutely. Tell us your venue, guest count and type of event, and we will recommend the right equipment for your budget.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Sound and PA system hire',
  provider: { '@id': 'https://thinkaudiovisual.co.za/#business' },
  areaServed: ['Durban', 'KwaZulu-Natal'],
};
---
<BaseLayout
  title="Sound & PA System Hire Durban | JBL Sound | Think Audio Visual"
  description="Professional sound hire in Durban: JBL PA systems, line arrays, subwoofers, wireless mics and DJ setups with an engineer on the desk. 10+ years' experience. Get a free quote."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }, { name: 'Sound Hire', href: '/services/sound-hire-durban/' }]}
  schema={[faqSchema, serviceSchema]}
>
  <PageHero
    eyebrow="01 / Sound hire · Durban"
    title="Sound & PA System Hire in Durban"
    lead="JBL PA systems, line arrays, subs and wireless mics, set up and run by people who care how your event sounds."
    slides={heroSlides.sound}
  >
    <a slot="secondary" href={whatsappHref} target="_blank" rel="noopener" class="btn btn-secondary">WhatsApp us</a>
  </PageHero>

  <!-- Equipment -->
  <section class="section">
    <div class="container-stage grid gap-12 lg:grid-cols-2 items-start">
      <div class="reveal">
        <p class="spec mb-3">What's included</p>
        <h2 class="h2">Professional sound, end to end</h2>
        <p class="lead mt-6">Every booking includes delivery, setup, sound check, an operator on the desk and strike at the end of the night.</p>
        <ul class="mt-8 border-t border-cable">
          {sound.items.map((i) => (
            <li class="flex justify-between gap-4 py-3 border-b border-cable"><span>{i}</span><span class="spec">For hire</span></li>
          ))}
        </ul>
        <p class="spec mt-6">Speaker systems by JBL Professional</p>
      </div>
      <Image src={img.soundKit} alt="Sound hire kit with PA speakers, subwoofers, mixer and wireless microphones" widths={[640, 960, 1400]} sizes="(min-width:1024px) 50vw, 100vw" class="w-full h-auto border border-cable reveal" />
    </div>
  </section>

  <!-- Packages -->
  <section class="section bg-case border-y border-cable">
    <div class="container-stage">
      <p class="spec mb-3">Popular setups</p>
      <h2 class="h2 mb-10">Sound packages</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {packages.map((p) => (
          <div class="border border-cable bg-stage p-8 reveal">
            <p class="spec !text-signal-ink">{p.spec}</p>
            <h3 class="h3 text-ink mt-2">{p.name}</h3>
            <ul class="mt-6 space-y-2 text-sm text-haze">
              {p.items.map((i) => <li>— {i}</li>)}
            </ul>
            {/* TODO(owner): add "from R…" prices if you want them public */}
            <a href={u('/contact/')} class="link-arrow inline-block mt-6 text-sm">Request this setup</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container-stage">
      <p class="spec mb-3">How it works</p>
      <h2 class="h2 mb-10">From enquiry to encore</h2>
      <ol class="grid gap-px bg-cable border border-cable sm:grid-cols-2 lg:grid-cols-5">
        {['Enquire', 'Venue check', 'Setup & sound check', 'Your event', 'Strike'].map((s, i) => (
          <li class="bg-stage p-6"><p class="font-display text-5xl text-signal-ink">0{i + 1}</p><p class="h3 text-ink mt-2">{s}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Engineer image band -->
  <section class="relative h-[60vh] overflow-hidden">
    <Image src={img.soundFoh} alt="Sound engineer mixing a live event" widths={[1280, 1920, 2560]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 overlay-stage"></div>
    <div class="container-stage relative h-full flex items-end pb-12">
      <p class="display max-w-[18ch]">An engineer on the desk, all night</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-stage max-w-3xl">
      <p class="spec mb-3">FAQ</p>
      <h2 class="h2 mb-8">Sound hire questions</h2>
      <div class="border-t border-cable">
        {faqs.map((f) => (
          <details class="group border-b border-cable py-5">
            <summary class="flex cursor-pointer list-none justify-between gap-6 h3 text-ink">
              {f.q}<span class="text-signal-ink transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-haze">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <QuoteCta />
</BaseLayout>
