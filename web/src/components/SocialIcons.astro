const items = [...site.social, { label: 'WhatsApp', icon: 'whatsapp', href: whatsappHref }];
---
<ul class="flex flex-wrap gap-2" aria-label="Think Audio Visual on social media">
  {items.map((s) => (
    <li>
      <a
        href={s.href || '/contact/'}
        target={s.href ? '_blank' : undefined}
        rel={s.href ? 'noopener' : undefined}
        aria-label={s.label}
        title={s.label}
        class="grid place-items-center w-10 h-10 border border-cable text-platinum hover:bg-signal hover:border-signal hover:text-stage hover:-translate-y-1 transition-all duration-300"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={paths[s.icon]} /></svg>
      </a>
    </li>
  ))}
</ul>
