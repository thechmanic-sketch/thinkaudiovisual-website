---
import { u } from '../utils/url';
// "Descent flyby" hero (see DESIGN.md §5).
// DESKTOP: a 300vh sticky section draws pre-loaded still frames on a <canvas> by scroll position
//          (frame-exact, no video seeking, so it behaves the same on every load).
// PHONES:  the flyby video plays once, holds the last frame for 20 s with a slow zoom + pan, then repeats.
// Desktop with motion switched off: seamless crossfaded loop.
import { whatsappHref } from '../data/site';
---
<section id="flyby" class="force-dark relative" style="height:300vh" aria-label="Think Audio Visual introduction">
  <!-- Decide desktop vs phone before first paint (same rule as the script below) -->
  <script is:inline>
    (function () {
      var s = document.getElementById('flyby');
      var fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
      var desktop = (fine && innerWidth >= 640) || innerWidth >= 1024;
      s.classList.add(desktop ? 'is-desktop' : 'is-phone');
    })();
  </script>
  <noscript><style>#flyby{height:100vh!important}#flyby .phase-final{opacity:1}#flyby .word,#scroll-hint{display:none}</style></noscript>

  <div class="sticky top-0 h-screen overflow-hidden">
    <canvas id="flyby-canvas" class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <video
      id="flyby-video"
      data-bg
      class="absolute inset-0 h-full w-full object-cover"
      muted
      playsinline
      preload="auto"
      poster={u('/flyby/f001.webp')}
    ></video>
    <!-- Phones: exact copy of the video's last frame; the 20 s zoom runs on this still (smooth on phones) -->
    <img id="flyby-hold" alt="" aria-hidden="true" decoding="async" />

    <div class="absolute inset-0 overlay-stage"></div>
    <div class="hero-fade-top"></div>
    <div class="hero-fade"></div>

    <!-- Words synced to the frames: each word sits on the thing it names -->
    <p data-phase="0" class="phase word word-sound display-xl" aria-hidden="true">Sound.</p>
    <p data-phase="1" class="phase word word-stage display-xl" aria-hidden="true">Stage.</p>
    <p data-phase="2" class="phase word word-light display-xl" aria-hidden="true">Light.</p>

    <div class="absolute inset-0 flex items-center">
      <div class="container-stage relative">
        <div data-phase="3" class="phase phase-final" id="hero-final">
          <p class="spec !text-signal-ink mb-4 flex items-center gap-3"><span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>Durban · KwaZulu-Natal · Since 20XX</p>
          <h1 class="display-xl max-w-[14ch]">
            <span class="line-mask"><span>Sound Hire &amp;</span></span>
            <span class="line-mask"><span>Event AV in</span></span>
            <span class="line-mask"><span>Durban</span></span>
          </h1>
          <p class="lead mt-6">PA systems, line arrays, screens, stages and lighting for conferences, weddings, churches and live events. Reliable at all times.</p>
          <div class="mt-8 flex flex-wrap gap-3" data-hero-cta>
            <a href={u('/contact/')} class="btn btn-primary">Get a Quote</a>
            <a href={whatsappHref} target="_blank" rel="noopener" class="btn btn-secondary">WhatsApp us</a>
          </div>
        </div>
      </div>
    </div>

    <button id="flyby-pause" hidden aria-pressed="false" class="absolute bottom-24 left-4 md:left-8 z-10 spec !text-platinum border border-cable bg-stage/60 px-3 py-2 hover:border-platinum">Pause video</button>

    <div id="scroll-hint" class="absolute bottom-24 left-1/2 -translate-x-1/2 z-10 spec !text-platinum flex flex-col items-center gap-2">
      <span id="flyby-status">Scroll</span>
      <span class="block w-px h-10 bg-platinum/60 animate-pulse"></span>
      <span class="flyby-progress" aria-hidden="true"><i id="flyby-bar"></i></span>
    </div>
  </div>
</section>

<style>
  .phase { opacity: 0; transition: opacity .5s var(--ease-stage), transform .8s var(--ease-stage), filter .6s; pointer-events: none; }
  .phase.on { opacity: 1; pointer-events: auto; }

  /* Media layers: canvas on desktop scroll mode, video everywhere else */
  #flyby.is-desktop:not(.static) #flyby-video { display: none; }
  #flyby.is-phone #flyby-canvas, #flyby.static #flyby-canvas { display: none; }
  /* Hold still: sits exactly over the video; GPU-composited so the slow zoom stays smooth */
  #flyby-hold { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; pointer-events: none;
    transform-origin: 50% 44%; will-change: transform; backface-visibility: hidden; transform: translateZ(0); }
  #flyby-hold.show { opacity: 1; }
  #flyby.is-desktop #flyby-hold { display: none; }

  /* Loading progress under the scroll hint (desktop, first visit) */
  .flyby-progress { width: 80px; height: 2px; background: rgba(255,255,255,.18); overflow: hidden; opacity: 0; transition: opacity .4s; }
  .flyby-progress i { display: block; height: 100%; width: 100%; transform-origin: 0 50%; transform: scaleX(0); background: linear-gradient(90deg, #5B8CFF, #2EF906); transition: transform .2s linear; }
  #flyby.is-loading .flyby-progress { opacity: 1; }

  /* Final headline block */
  .phase-final { position: absolute; inset-inline: 16px; top: 50%; transform: translateY(-46%); transition-duration: .25s; }
  .phase-final.on { transition: opacity .7s var(--ease-stage) .25s, transform .9s var(--ease-stage) .25s; transform: translateY(-50%); }
  .word:not(.on) { transition-duration: .25s; }
  /* Desktop: headline in the left column so the logo on the stage screen stays visible */
  #flyby:not(.is-phone) .phase-final { inset-inline: 32px; right: auto; max-width: min(36vw, 560px); }
  #flyby:not(.is-phone) .phase-final h1 { font-size: clamp(56px, 6.2vw, 96px); }
  #flyby:not(.is-phone) .phase-final .lead { font-size: 16px; }

  /* Words, positioned on the matching part of the frame */
  .word { position: absolute; margin: 0; line-height: .85; white-space: nowrap; }
  /* SOUND: beside the hanging line-array speaker (top-left of the opening frame) */
  .word-sound { left: clamp(120px, 15vw, 260px); top: 22%; transform: translateX(-30px); }
  .word-sound.on { transform: none; }
  .word-sound::before { content: ''; position: absolute; left: -48px; top: 50%; width: 36px; height: 2px; background: var(--color-signal); }
  /* STAGE: standing ON the stage floor — bottom edge on the floor line, tracked per frame (JS sets --floor-y, --stage-s) */
  .word-stage { left: 50%; top: var(--floor-y, 60%); transform-origin: 50% 100%; transform: translate(-50%, -100%) scale(var(--stage-s, .7)); transition: opacity .5s var(--ease-stage), filter .6s; text-shadow: 0 18px 30px rgba(0,0,0,.55); }
  .word-stage::after { content: ''; position: absolute; left: 4%; right: 4%; bottom: -2px; height: 2px; background: linear-gradient(90deg, transparent, rgba(91,140,255,.9), rgba(46,249,6,.9), transparent); }
  /* LIGHT: bursts in with the beams, glowing */
  .word-light { left: 50%; top: 24%; transform: translate(-50%, -50%) scale(1.25); filter: blur(10px); font-size: clamp(80px, 13vw, 180px); }
  .word-light.on { transform: translate(-50%, -50%) scale(1); filter: blur(0); text-shadow: 0 0 30px rgba(91,140,255,.8), 0 0 80px rgba(46,249,6,.35); }
  .phase.on .line-mask > span { transform: none; }
  .phase .line-mask:nth-child(2) > span { transition-delay: .1s; }
  .phase .line-mask:nth-child(3) > span { transition-delay: .2s; }

  /* Static modes (phone, or desktop with motion off): single screen, headline always visible */
  #flyby.static, #flyby.is-phone { height: 100vh !important; height: 100svh !important; }
  /* The inner layer must match the section exactly. (h-screen = 100vh is taller than 100svh on phones
     with an address bar, which pushed the buttons out under the equipment strip.) */
  #flyby.static > .sticky, #flyby.is-phone > .sticky { position: relative; height: 100%; }
  #flyby.static .word, #flyby.is-phone .word, #flyby.static #scroll-hint, #flyby.is-phone #scroll-hint { display: none; }
  #flyby.static .phase-final, #flyby.is-phone .phase-final { opacity: 1; pointer-events: auto; }
  #flyby.static .phase-final .line-mask > span, #flyby.is-phone .phase-final .line-mask > span { transform: none; }

  /* Phone layout: headline below the logo on the stage screen (logo is ~45% down the frame) */
  #flyby.is-phone .container-stage { position: static; }
  #flyby.is-phone .phase-final { position: absolute; top: auto !important; bottom: 28px; transform: none !important; }
  #flyby.is-phone .phase-final h1 { font-size: clamp(40px, 11.5vw, 48px); }
  #flyby.is-phone .phase-final .lead { font-size: 15px; margin-top: 12px; }
  #flyby.is-phone .phase-final [data-hero-cta] { margin-top: 18px; }
  #flyby.is-phone .phase-final .btn { padding: 14px 18px; font-size: 13px; }
  #flyby.is-phone #flyby-pause { top: 76px; bottom: auto !important; left: auto !important; right: 16px; }
</style>

<script>
  const section = document.getElementById('flyby')!;
  const BASE = import.meta.env.BASE_URL.replace(/\/$/, ''); // real domain and GitHub Pages sub-path
  const V = BASE + '/video';
  const video = document.getElementById('flyby-video') as HTMLVideoElement;
  const canvas = document.getElementById('flyby-canvas') as HTMLCanvasElement;
  const phases = [...section.querySelectorAll<HTMLElement>('.phase')];
  const hint = document.getElementById('scroll-hint')!;

  const motionOff = document.documentElement.classList.contains('motion-off');
  const saveData = (navigator as any).connection?.saveData === true;
  const isDesktop = () => (matchMedia('(hover: hover) and (pointer: fine)').matches && innerWidth >= 640) || innerWidth >= 1024;
  const desktop = section.classList.contains('is-desktop');

  // Reloads always start at the top so the flyby begins on its first frame
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  if (!location.hash) scrollTo(0, 0);

  // If the window is resized across the desktop/phone line, reload into the right mode
  let resizeTimer = 0;
  addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => { if (isDesktop() !== desktop) location.reload(); }, 400);
  });

  const showFinal = () => phases.forEach((p) => p.classList.toggle('on', p.dataset.phase === '3'));

  if (desktop && !motionOff && !saveData) {
    /* ───────────── DESKTOP: canvas frame flyby ───────────── */
    const FPS = 12, COUNT = 121, DUR = (COUNT - 1) / FPS;      // frames f001..f121 = 0 s .. 10 s
    const frames: (HTMLImageElement | null)[] = new Array(COUNT).fill(null);
    const ctx = canvas.getContext('2d')!;
    const status = document.getElementById('flyby-status')!;
    const bar = document.getElementById('flyby-bar')!;

    // Timings measured from the video (seconds)
    const T = { stage: 3.55, light: 5.1, final: 7.5 };
    const stageWord = section.querySelector<HTMLElement>('.word-stage')!;
    const FLOOR: [number, number][] = [[3.25, 16], [3.65, 22], [4.05, 29], [4.45, 36], [4.84, 43], [5.1, 47]];
    const SCALE: [number, number][] = [[3.55, 0.55], [5.1, 1.0]];
    const lerpTable = (tbl: [number, number][], x: number) => {
      if (x <= tbl[0][0]) return tbl[0][1];
      for (let i = 1; i < tbl.length; i++) if (x <= tbl[i][0]) {
        const [x0, y0] = tbl[i - 1], [x1, y1] = tbl[i];
        return y0 + ((x - x0) / (x1 - x0)) * (y1 - y0);
      }
      return tbl[tbl.length - 1][1];
    };

    // Size the canvas to the screen (sharp on high-DPI)
    const fit = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      drawn = -1; requestRender();
    };

    // Draw a frame "object-fit: cover"; if it isn't loaded yet, use the nearest loaded one
    let drawn = -1;
    const draw = (idx: number) => {
      let img = frames[idx];
      if (!img) for (let d = 1; d < COUNT && !img; d++) img = frames[idx - d] || frames[idx + d] || null;
      if (!img) return;
      const key = frames.indexOf(img);
      if (key === drawn) return;
      drawn = key;
      const cw = canvas.width, ch = canvas.height, s = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * s, h = img.naturalHeight * s;
      ctx.drawImage(img, (cw - w) / 2, (ch - h) / 2, w, h);
    };

    // Load all frames, coarse-to-fine (every 16th, then 8th, 4th…), so any scroll position
    // shows a close frame immediately and the sequence sharpens as the rest arrive.
    const order: number[] = [];
    for (let step = 16; step >= 1; step = step >> 1) for (let i = 0; i < COUNT; i += step) if (!order.includes(i)) order.push(i);
    let loaded = 0;
    section.classList.add('is-loading');
    status.textContent = 'Loading';
    const loadOne = (i: number) => new Promise<void>((done) => {
      const img = new Image();
      img.decoding = 'async';
      img.src = `${BASE}/flyby/f${String(i + 1).padStart(3, '0')}.webp`;
      const finish = () => { loaded++; bar.style.transform = `scaleX(${loaded / COUNT})`; done(); };
      // Use the frame as soon as it has loaded; decode() is only a hint (it can stall in background tabs)
      img.onload = () => { img.decode?.().catch(() => {}); frames[i] = img; drawn = -1; requestRender(); finish(); };
      img.onerror = finish;
    });
    (async () => {
      const queue = order.slice();
      const workers = Array.from({ length: 6 }, async () => { while (queue.length) await loadOne(queue.shift()!); });
      await Promise.all(workers);
      section.classList.remove('is-loading');
      status.textContent = 'Scroll';
    })();

    // Scroll → eased target → frame
    let target = 0, current = 0, ticking = false, last = 0;
    const progress = () => {
      const r = section.getBoundingClientRect();
      const total = section.offsetHeight - innerHeight;
      return Math.min(1, Math.max(0, -r.top / total));
    };
    const render = (now: number) => {
      // Time-based easing (~120 ms to settle): identical feel at 30, 60 or 144 fps, and it
      // always catches up even if the computer drops frames.
      const dt = last ? Math.min(now - last, 250) : 16;
      last = now;
      current += (target - current) * (1 - Math.exp(-dt / 120));
      if (Math.abs(target - current) < 0.0005) current = target;
      const t = current * DUR;
      draw(Math.round(t * FPS));
      // Words follow the frame actually drawn
      const active = t < T.stage ? 0 : t < T.light ? 1 : t < T.final ? 2 : 3;
      phases.forEach((el) => el.classList.toggle('on', Number(el.dataset.phase) === active));
      const fy = lerpTable(FLOOR, t);
      const vw = innerWidth, vh = innerHeight;
      const scaleH = Math.max(vh, vw / (16 / 9));
      stageWord.style.setProperty('--floor-y', `${(vh - scaleH) / 2 + (fy / 100) * scaleH}px`);
      stageWord.style.setProperty('--stage-s', String(lerpTable(SCALE, t)));
      hint.style.opacity = target > 0.04 ? '0' : '1';
      if (current !== target) requestAnimationFrame(render); else { ticking = false; last = 0; }
    };
    function requestRender() { target = progress(); if (!ticking) { ticking = true; requestAnimationFrame(render); } }
    addEventListener('scroll', requestRender, { passive: true });
    addEventListener('resize', fit);
    // If the page was opened in a background tab, start fresh when it becomes visible
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { ticking = false; last = 0; drawn = -1; requestRender(); } });
    fit();
  } else {
    /* ───────────── PHONE (and desktop with motion off / Save-Data) ───────────── */
    section.classList.add('static');
    showFinal();
    if (!saveData) {
      const btn = document.getElementById('flyby-pause')!;
      btn.hidden = false;
      let holding = false;       // last frame is being held
      let stopped = motionOff;   // visitor pressed Pause (or motion is off)
      let holdTimer = 0;
      const HOLD_MS = 20000, EASE_BACK_MS = 1600, ZOOM = 1.12;
      const holdImg = document.getElementById('flyby-hold') as HTMLImageElement;
      let zoomAnim: Animation | null = null;

      // Hold sequence on the still image: slow push-in toward the logo, then ease back
      const startHoldZoom = () => {
        holdImg.classList.add('show');
        zoomAnim?.cancel();
        zoomAnim = holdImg.animate(
          [
            { transform: 'translateZ(0) scale(1)', offset: 0, easing: 'cubic-bezier(.37,0,.63,1)' },
            { transform: `translateZ(0) scale(${ZOOM})`, offset: 1 - EASE_BACK_MS / HOLD_MS, easing: 'cubic-bezier(.65,0,.35,1)' },
            { transform: 'translateZ(0) scale(1)', offset: 1 },
          ],
          { duration: HOLD_MS, fill: 'forwards' }
        );
      };
      const endHold = () => { zoomAnim?.cancel(); zoomAnim = null; holdImg.classList.remove('show'); };

      if (!desktop) {
        // Phones: play once → hold last frame 20 s (slow zoom on a still copy) → replay
        video.innerHTML = `<source src="${V}/hero-flyby-mobile.webm" type="video/webm"><source src="${V}/hero-flyby-mobile.mp4" type="video/mp4">`;
        video.poster = `${V}/hero-flyby-mobile-poster.jpg`;
        video.loop = false;
        holdImg.src = `${V}/hero-flyby-end.webp`;
        holdImg.onerror = () => { holdImg.onerror = null; holdImg.src = `${V}/hero-flyby-end.jpg`; };
        video.addEventListener('ended', () => {
          holding = true; sync();
          clearTimeout(holdTimer);
          startHoldZoom();
          holdTimer = window.setTimeout(() => {
            holding = false;
            if (stopped) return;
            video.currentTime = 0;
            video.play().catch(() => {});
            // hide the still once the video is actually showing frames again (no flash)
            video.addEventListener('playing', endHold, { once: true });
          }, HOLD_MS);
        });
      } else {
        // Desktop with motion off: seamless crossfaded loop (starts paused)
        video.innerHTML = `<source src="${V}/hero-flyby-loop.webm" type="video/webm"><source src="${V}/hero-flyby-loop.mp4" type="video/mp4">`;
        video.poster = `${V}/hero-flyby-loop-poster.jpg`;
        video.loop = true;
      }
      video.load();
      if (!stopped) { video.autoplay = true; video.play().catch(() => {}); }

      function sync() {
        const off = stopped || (video.paused && !holding);
        btn.textContent = off ? 'Play video' : 'Pause video';
        btn.setAttribute('aria-pressed', String(off));
      }
      sync(); video.addEventListener('play', sync); video.addEventListener('pause', sync);
      btn.addEventListener('click', () => {
        if (stopped || (video.paused && !holding)) {
          stopped = false;
          if (holding || video.ended) {
            clearTimeout(holdTimer); holding = false;
            video.currentTime = 0;
            video.addEventListener('playing', endHold, { once: true });
          }
          video.play().catch(() => {});
        } else {
          stopped = true;
          clearTimeout(holdTimer);
          zoomAnim?.pause(); // freeze the zoom where it is
          video.pause();
        }
        sync();
      });
    }
  }
</script>
