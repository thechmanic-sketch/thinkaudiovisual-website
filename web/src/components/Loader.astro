---
// First-visit loader: just the logo. Its own 9 equaliser bars move like a live sound check,
// a hairline fills, then the bars settle into the logo's exact shape and the screen lifts.
// Shown once per browser session; later page visits skip it.
import paths from '../assets/brand/logo-paths.json';
const parts = paths.bars.split(/(?=M)/).filter(Boolean);
const bars = parts.slice(0, 9);   // the 9 equaliser bars (left → right)
const lines = parts.slice(9);     // the two side lines
---
<div id="site-loader" role="status" aria-label="Loading Think Audio Visual">
  <div class="ld-inner">
    <svg class="ld-logo" viewBox="60 36 1720 740" aria-hidden="true">
      <g class="ld-lines" fill="#2DC410">{lines.map((d) => <path d={d} />)}</g>
      <g fill="#2DC410">{bars.map((d, i) => <path class="ld-bar" data-i={i} d={d} />)}</g>
      <path class="ld-word" fill="#FFFFFF" fill-rule="evenodd" d={paths.text} />
      <path class="ld-word ld-visual" fill="#2DC410" fill-rule="evenodd" d={paths.visual} />
    </svg>
    <div class="ld-meter" aria-hidden="true">
      <span class="ld-track"><i id="ld-fill"></i></span>
      <span id="ld-pct" class="ld-pct">00</span>
    </div>
  </div>
</div>

<style>
  #site-loader { position: fixed; inset: 0; z-index: 200; display: none; place-items: center; background: #0B0C0E;
    transition: opacity .6s cubic-bezier(.4,0,.2,1), visibility 0s linear .6s; }
  :global(html.show-loader) #site-loader { display: grid; }
  :global(html.loader-done) #site-loader { opacity: 0; visibility: hidden; pointer-events: none; }
  :global(html.show-loader:not(.loader-done)) body { overflow: hidden; }

  .ld-inner { display: flex; flex-direction: column; align-items: center; transition: transform .6s cubic-bezier(.4,0,.2,1); }
  :global(html.loader-done) .ld-inner { transform: scale(.96); }

  .ld-logo { width: clamp(150px, 22vw, 210px); height: auto; overflow: visible; }
  .ld-bar { transform-box: fill-box; transform-origin: 50% 100%; }
  .ld-lines path { transform-box: fill-box; transform-origin: 50% 50%; transform: scaleX(0); animation: ld-line .7s cubic-bezier(.2,.7,.2,1) .15s forwards; }
  .ld-word { opacity: 0; animation: ld-fade .8s ease .45s forwards; }
  .ld-visual { animation-delay: .65s; }

  .ld-meter { margin-top: 28px; display: flex; align-items: center; gap: 12px; opacity: 0; animation: ld-fade .6s ease .3s forwards; }
  .ld-track { position: relative; width: 120px; height: 1px; background: rgba(255,255,255,.14); overflow: hidden; }
  .ld-track i { position: absolute; inset: 0; background: #2DC410; transform-origin: 0 50%; transform: scaleX(0); }
  .ld-pct { font-family: var(--font-spec); font-size: 10px; letter-spacing: .12em; color: rgba(236,237,240,.55); min-width: 2ch; font-variant-numeric: tabular-nums; }

  @keyframes ld-fade { to { opacity: 1; } }
  @keyframes ld-line { to { transform: scaleX(1); } }
</style>

<script>
  const root = document.documentElement;
  if (root.classList.contains('show-loader')) {
    const pct = document.getElementById('ld-pct')!;
    const fill = document.getElementById('ld-fill')!;
    const bars = [...document.querySelectorAll<SVGPathElement>('#site-loader .ld-bar')];
    const quick = root.classList.contains('motion-off');
    const MIN = quick ? 600 : 1900;    // minimum on screen
    const SETTLE = 450;                // bars ease into the logo's shape

    // Each bar gets its own rhythm, like a real level meter
    const anims = bars.map((bar, i) => {
      const seed = [0.62, 0.41, 0.86, 0.33, 0.71, 0.47, 0.93, 0.38, 0.57][i];
      return bar.animate(
        [
          { transform: 'scaleY(.18)' },
          { transform: `scaleY(${(0.55 + seed * 0.45).toFixed(2)})` },
          { transform: `scaleY(${(0.25 + seed * 0.3).toFixed(2)})` },
          { transform: 'scaleY(1)' },
          { transform: 'scaleY(.18)' },
        ],
        { duration: 700 + seed * 500, delay: -seed * 600, iterations: Infinity, easing: 'ease-in-out' }
      );
    });

    // Progress: eases up to 90% while the page loads, then completes during the settle (never goes backwards)
    const t0 = performance.now();
    let shown = 0, settleStart = 0, from = 0, done = false;
    const tick = (now: number) => {
      if (settleStart) {
        const k = Math.min(1, (now - settleStart) / SETTLE);
        shown = from + (1 - from) * (1 - Math.pow(1 - k, 3));
      } else {
        const p = Math.min(1, (now - t0) / (MIN - SETTLE));
        shown = Math.max(shown, 0.9 * (1 - Math.pow(1 - p, 2)));
      }
      fill.style.transform = `scaleX(${shown})`;
      pct.textContent = String(Math.round(shown * 100)).padStart(2, '0');
      if (!done) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    const settle = () => new Promise<void>((resolve) => {
      settleStart = performance.now(); from = shown;
      // freeze each bar where it is, then glide to its real logo height
      anims.forEach((a, i) => {
        const now = getComputedStyle(bars[i]).transform;
        a.cancel();
        bars[i].animate([{ transform: now === 'none' ? 'scaleY(1)' : now }, { transform: 'scaleY(1)' }],
          { duration: SETTLE, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'forwards' });
      });
      setTimeout(resolve, SETTLE + 150);
    });

    const finish = () => {
      done = true;
      fill.style.transform = 'scaleX(1)'; pct.textContent = '100';
      root.classList.add('loader-done');
      try { sessionStorage.setItem('tav-loaded', '1'); } catch {}
      setTimeout(() => root.classList.remove('show-loader'), 700);
    };

    const minTime = new Promise((r) => setTimeout(r, MIN - SETTLE));
    const loaded = new Promise((r) => (document.readyState === 'complete' ? r(null) : addEventListener('load', () => r(null), { once: true })));
    Promise.race([Promise.all([minTime, loaded]), new Promise((r) => setTimeout(r, 6000))])
      .then(settle)
      .then(finish);
  }
</script>
