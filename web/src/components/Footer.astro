---
import Logo from './Logo.astro';
import SocialIcons from './SocialIcons.astro';
import { site, services } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="bg-case border-t border-cable mt-0">
  <div class="container-stage py-16 grid gap-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" aria-label="Think Audio Visual home" class="inline-block"><Logo class="h-16" /></a>
      <p class="mt-5 text-haze text-sm max-w-xs">Sound, AV, staging and lighting hire for conferences, weddings, churches and live events across KwaZulu-Natal.</p>
      <p class="spec mt-5">Reliable at all times</p>
      <div class="mt-6"><SocialIcons /></div>
    </div>
    <div>
      <p class="spec mb-4">Services</p>
      <ul class="space-y-2 text-sm">
        {services.map((s) => <li><a class="hover:text-ink" href={`/services/${s.slug}/`}>{s.title}</a></li>)}
        <li><a class="hover:text-ink" href="/our-work/">Our Work</a></li>
      </ul>
    </div>
    <div>
      <p class="spec mb-4">Areas we serve</p>
      <p class="text-sm text-haze leading-relaxed">{site.areas.join(' · ')}</p>
    </div>
    <address class="not-italic text-sm space-y-2">
      <p class="spec mb-4">Contact</p>
      <p class="font-medium text-ink">{site.name}</p>
      <p>{site.address.street}, {site.address.suburb}<br />{site.address.city}, {site.address.postalCode}</p>
      <p>Cell: <a class="hover:text-ink" href={`tel:${site.phone.tel}`}>{site.phone.display}</a></p>
      <p>Tel: <a class="hover:text-ink" href={`tel:${site.landline.tel}`}>{site.landline.display}</a></p>
      <p><a class="hover:text-ink" href={`mailto:${site.email}`}>{site.email}</a></p>
    </address>
  </div>
  <div class="border-t border-cable">
    <div class="container-stage py-6 flex flex-col md:flex-row gap-3 justify-between text-xs text-haze">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="flex flex-wrap items-center gap-6"><button id="motion-toggle" class="spec !text-[11px] border border-cable px-2 py-1 hover:border-platinum">Motion: on</button><a href="/privacy/" class="hover:text-ink">Privacy (POPIA)</a><span class="spec !text-[11px]">Built in Durban</span></p>
    </div>
  </div>
</footer>
